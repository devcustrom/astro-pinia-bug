---
import { getActivePinia } from "../store/pinia";
import Layout from '../layouts/Main.astro'
import Test from "../components/Test.vue";
import { useTestStore } from '../store/teststore'
const pinia = await getActivePinia()
const testStore = useTestStore(pinia)
testStore.$reset()
testStore.arr = [
	'indexValue'
]
---
<Layout>
	<h1>Astro</h1>
	<ul>
		{
			testStore.arr.map(item => (
				<li>{item}</li>
			))
		}
	</ul>
	<div class="grid max-w-max gap-4">
		<a class="ring" href="/test/">Test</a>
		<a class="ring" href="/piniaStatePage/">piniaStatePage</a>
	</div>
	<Test
		client:load
	/>
</Layout>
