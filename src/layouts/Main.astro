---
import { ClientRouter } from "astro:transitions"
import { getActivePinia } from "../store/pinia"
import '@styles/index.css'
import { serializeQueryCache, useQueryCache } from "@pinia/colada"
const pinia = await getActivePinia()
const queryCache = useQueryCache(pinia)
const stateColada = JSON.stringify(serializeQueryCache(queryCache))
queryCache.caches.clear()
const statePinia = JSON.stringify(pinia.state.value)
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
		<ClientRouter/>
		<Fragment
			set:html={`<script type="application/json" id="pinia-state">${statePinia}</script>`}
		/>
		<Fragment
			set:html={`<script type="application/json" id="colada-state">${stateColada}</script>`}
		/>
	</head>
	<body>
		<slot/>
	</body>
</html>

<script>
	document.addEventListener('astro:before-swap', (e) => {
		if (e.to.pathname === e.from.pathname) e.swap = () => {}
	})
</script>
